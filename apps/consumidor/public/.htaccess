# Rotas internas (/r/{token}) caem no index.html. O caminho base vem do build.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Só endereços SEM extensão (as rotas, ex.: /r/TOKEN) caem no app. Arquivo que não existe (.glb, .webp, .js...) dá 404 de verdade.
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{2,5}$
RewriteRule ^ index.html [L]
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
# O site da Uman (pasta acima) proíbe localização/câmera/microfone para todos. O SemReservas precisa da
# localização do aparelho para confirmar que o cliente está no restaurante (somente neste app, "self").
Header always unset Permissions-Policy
Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
# Tipos corretos para os modelos 3D (a realidade aumentada do Android e do iPhone confere o tipo do arquivo).
AddType model/gltf-binary .glb
AddType model/vnd.usdz+zip .usdz
